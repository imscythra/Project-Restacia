<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Project_Restacia_UWP.Views.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Project_Restacia_UWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" CornerRadius="12"
    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}">

    <Grid CornerRadius="8" Width="500">
        <Grid CornerRadius="12" Height="200" Width="500" VerticalAlignment="Top" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1">
            <Image Source="/Assets/welcomebanner.png" Stretch="UniformToFill"/>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Visible" Margin="0,200,0,48">
            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Introducing Restacia" Margin="0,16,0,0"/>
                <TextBlock TextWrapping="Wrap">
                     Restacia is your personal <Bold>mental health companion</Bold>, featuring meditational activities, curated playlist of
                     relaxing Spotify tracks, helpful guides and a friendly AI-powered psychological partner.
                </TextBlock>
                <InfoBar Title="Disclaimer" Margin="0,12,0,0" Severity="Informational"
                         Message="This app is a functional prototype of the Restacia project, and it's not completed. Should there be some rough edges and bugs, kindly report it from the profile page."
                         IsOpen="True" IsIconVisible="False" IsClosable="False"/>
                
            </StackPanel>
        </ScrollViewer>
        <CheckBox Click="CheckBox_Click" Margin="0,12,0,0" Content="Don't show this again" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
        <Button Style="{ThemeResource AccentButtonStyle}" Click="Button_Click" Content="Close" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</ContentDialog>
